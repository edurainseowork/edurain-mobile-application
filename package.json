{
  "name": "edurain-mobile-application",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:all:preview": "eas build -p all --profile preview",
    "build:all:prod": "eas build -p all --profile production",
