    "@msg91comm/sendotp-react-native": "^3.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.7",
