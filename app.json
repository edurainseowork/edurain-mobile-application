{
  "expo": {
    "name": "EDURAIN",
    "slug": "edurainindia",
    "owner": "edurainindia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edurain",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": true
    },
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edurainindia.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow EDURAIN to access your photo library to set your profile picture and upload study doubt images.",
        "NSCameraUsageDescription": "Allow EDURAIN to access your camera to take a profile picture and capture doubt problems.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.edurainindia.app",
      "googleServicesFile": "./google-services.json",
      "splash": {
        "image": "./assets/images/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#175A67",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EDURAIN to access your photo library to set your profile picture and upload study doubt images.",
          "cameraPermission": "Allow EDURAIN to access your camera to take a profile picture and capture doubt problems."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de7a99e0-3c7e-4173-a866-6a316d37a0f2"
      }
    }
  }
}
