# ==============================================================================
# EduRain Mobile App Environment Configuration (.env.example)
# Only variables prefixed with EXPO_PUBLIC_ are bundled into the app.
# NEVER put server secrets, private keys, or database URLs here.
# ==============================================================================

# Backend API Endpoints
EXPO_PUBLIC_API_URL=https://sjlfsfe8jf.execute-api.ap-south-1.amazonaws.com
EXPO_PUBLIC_FALLBACK_API_URL=https://sjlfsfe8jf.execute-api.ap-south-1.amazonaws.com
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Razorpay Public Key ID
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Firebase Client Configuration for Mobile Auth
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Live doubt chat (Firebase Realtime Database URL), e.g. https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Expo EAS Project ID
EXPO_PUBLIC_EAS_PROJECT_ID=

